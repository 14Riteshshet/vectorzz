# SookshmaJal – Environment Variables
# Copy this file to .env and fill in your values.
# Team VECTORZZ · Hackwarts 2026

# ── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (dev). Switch to PostgreSQL for production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sookshmajal
DATABASE_URL=sqlite+aiosqlite:///./sookshmajal.db

# ── Sarvam AI (Kannada TTS + Translation) ────────────────────────────────────
# Get your key at https://www.sarvam.ai/
# Leave blank to use text-only fallback advisory.
SARVAM_API_KEY=

# ── CORS Allowed Origins ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Planetary Computer ────────────────────────────────────────────────────────
# Optional API key for higher rate limits.
# Leave blank for anonymous access (rate-limited but sufficient for hackathon).
PLANETARY_COMPUTER_API_KEY=

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
PDF_OUTPUT_DIR=generated_pdfs
FALLBACK_CACHE_DIR=fallback_cache

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_ANALYZE=10/minute
RATE_LIMIT_VERIFY=30/minute
